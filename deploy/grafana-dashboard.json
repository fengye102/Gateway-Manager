{
  "__inputs": [
    {
      "name": "DS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "QPS（1 分钟）",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pojiagw_requests_total[1m]))",
          "legendFormat": "QPS",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "上游健康",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pojiagw_upstream_healthy)",
          "legendFormat": "健康",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "count(pojiagw_upstream_healthy)",
          "legendFormat": "总数",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "注入构成",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pojiagw_rule_injections_total)",
          "legendFormat": "规则注入",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "sum(pojiagw_profile_injections_total)",
          "legendFormat": "策略注入",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "C",
          "expr": "sum(pojiagw_no_profile_total)",
          "legendFormat": "未注入",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "拦截 / 错误",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pojiagw_rule_denies_total)",
          "legendFormat": "规则拦截",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "sum(pojiagw_upstream_errors_total)",
          "legendFormat": "上游错误",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "配置规模 / 快照 / 回放",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pojiagw_config_upstreams",
          "legendFormat": "上游",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "pojiagw_config_rules",
          "legendFormat": "规则",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "C",
          "expr": "pojiagw_snapshots",
          "legendFormat": "快照",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "D",
          "expr": "pojiagw_replay_entries",
          "legendFormat": "回放",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "运行时长",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pojiagw_uptime_seconds",
          "legendFormat": "uptime",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "上游延迟 p95 / p50",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, upstream) (rate(pojiagw_upstream_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{upstream}}",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le, upstream) (rate(pojiagw_upstream_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{upstream}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "按端点请求速率",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(pojiagw_requests_by_endpoint_total[1m]))",
          "legendFormat": "{{endpoint}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "注入 / 拦截速率",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pojiagw_rule_injections_total[1m]))",
          "legendFormat": "规则注入",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pojiagw_profile_injections_total[1m]))",
          "legendFormat": "策略注入",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "C",
          "expr": "sum(rate(pojiagw_rule_denies_total[1m]))",
          "legendFormat": "规则拦截",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "D",
          "expr": "sum(rate(pojiagw_upstream_errors_total[1m]))",
          "legendFormat": "上游错误",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "上游响应码",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (upstream, code) (rate(pojiagw_upstream_responses_total[$__rate_interval]))",
          "legendFormat": "{{upstream}} {{code}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "key 健康评分",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pojiagw_key_score",
          "legendFormat": "{{upstream}} {{key}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "green",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "规则命中占比",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pojiagw_rule_hit_ratio",
          "legendFormat": "{{rule}}",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "pojiagw",
    "llm-gateway",
    "openai-proxy"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "label": "数据源",
        "multi": false,
        "name": "DS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "timezone": "browser",
  "title": "网关管家 pojiagw",
  "uid": "pojiagw-main",
  "version": 1,
  "weekStart": ""
}